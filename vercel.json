{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/app/version.json",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "dest": "/public/app/version.json"
    },
    {
      "src": "/app/(.*)",
      "dest": "/public/app/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
